local Patch=require("../../src/TikkiesPatches")
local fixtures=require("../fixtures/tikkies-native-fixtures")
local bridge=Patch.Bridge(fixtures.bridge)
local server=Patch.Server(fixtures.server)
assert(loadstring(bridge),"Patched native bridge must compile")
assert(loadstring(server),"Patched native game server must compile")
assert(Patch.Bridge(bridge)==bridge and Patch.Server(server)==server,"Installer must be idempotent")
assert(Patch.Bridge(fixtures.bridgeV1)==bridge,"Already-installed V1 must upgrade identically to a fresh baseline")
assert(Patch.Bridge(fixtures.bridgeV2)==bridge,"Already-installed V2 must upgrade to POST without changing the processor")
local function processor(source)
 local first=assert(source:find("local function process(e, playerId, session, version)",1,true))
 local last=assert(source:find("\nend\n",first,true))
 return source:sub(first,last+4)
end
assert(processor(bridge)==processor(fixtures.bridge),"Native gift/profile/follow/like processor must remain unchanged")
assert(not pcall(Patch.Bridge,"local unexpected = true"),"Unexpected native drift must stop installation")
local changed=fixtures.bridge:gsub("local busy, cooldown = false, {}","local busy, cooldown = false, {}\n-- new unrelated native work")
assert(Patch.Bridge(changed):find("-- new unrelated native work",1,true),"Narrow patch must preserve unrelated newer source")
print("PASS Tikkies native patches: compile, idempotence, processor preservation, drift rejection")
